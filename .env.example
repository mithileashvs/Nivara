# ---------------------------------------------------------------
# Nivara backend configuration.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------

# development | test | production  (production enforces a strong JWT secret)
ENVIRONMENT=development

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/nivara
DATABASE_NAME=nivara

# JWT — generate a secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed browser origins (your React dev server, etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Clinic-local timezone used to interpret slot dates/times (IANA name)
APP_TIMEZONE=Asia/Kolkata

# --- Scheduling / slot holds ---------------------------------------
# How long a REQUESTED appointment holds its slot while the doctor decides
REQUEST_HOLD_MINUTES=720
MAX_PENDING_REQUESTS_PER_PATIENT=5
MAX_SCHEDULING_HORIZON_DAYS=90
MIN_BOOKING_LEAD_MINUTES=15

# --- Background maintenance (expire stale holds, send reminders) ----
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_JOB_INTERVAL_SECONDS=60
REMINDER_HOURS_BEFORE=24

# --- Smart waitlist -------------------------------------------------
WAITLIST_NOTIFY_TOP_N=3
WAITLIST_MAX_ACTIVE_ENTRIES_PER_PATIENT=10

# --- Rate limiting (in-process, per client IP; see README) ---------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Logging --------------------------------------------------------
LOG_LEVEL=INFO

# Optional: override matching weights (JSON). Omitted keys keep defaults.
# MATCHING_CONFIG={"weights":{"specialty":40,"availability_soon":25}}
